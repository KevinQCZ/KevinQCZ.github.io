{
  "name": "personal-site-admin-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-site-admin-production",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "91001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "91002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://kevinqcz.github.io",
    "API_ORIGIN": "https://REPLACE_WITH_WORKER_HOST.workers.dev",
    "GITHUB_CLIENT_ID": "REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID",
    "ADMIN_GITHUB_IDS": "REPLACE_WITH_VERIFIED_NUMERIC_GITHUB_ID",
    "GITHUB_APP_ID": "REPLACE_WITH_GITHUB_APP_ID",
    "GITHUB_APP_INSTALLATION_ID": "REPLACE_WITH_REPOSITORY_INSTALLATION_ID"
  }
}
