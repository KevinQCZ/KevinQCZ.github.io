---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'zh-Hans';
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description,
  lang = 'en',
  type = 'website',
  publishedTime
} = Astro.props;
const site = Astro.site;

if (!site) {
  throw new Error('Set the site URL in astro.config.mjs before building.');
}

const canonicalUrl = new URL(Astro.url.pathname, site).href;
const locale = lang === 'zh-Hans' ? 'zh_CN' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F8FA" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Qian Kevin" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Qian Kevin RSS" href="/rss.xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32-next.png" />
    <link rel="stylesheet" href="/css/design-system.css" />
    <script is:inline src="/js/theme-init.js"></script>
    <script is:inline src="/js/site.js" defer></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'zh-Hans' ? '跳转到正文' : 'Skip to content'}</a>
    <SiteHeader lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
